[Unit]
Description=BharatPulse MCP HTTP server
After=network.target hmisindia-api.service
Requires=hmisindia-api.service

[Service]
Type=simple
User=sramap
Group=sramap
WorkingDirectory=/home/sramap/bharatpulse
Environment=MCP_TRANSPORT=http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=9000
Environment=BHARATPULSE_HMIS_URL=http://127.0.0.1:8765
ExecStart=/home/sramap/bharatpulse/.venv/bin/bharatpulse-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
